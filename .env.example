# Cấu hình biến môi trường (KHÔNG commit file .env thật chứa khóa riêng lên Git)
# Tạo file .env và điền thông tin khi cần deploy từ CLI hoặc verify Etherscan

# RPC Sepolia (Infura, Alchemy, hoặc public RPC)
SEPOLIA_RPC_URL=https://rpc.sepolia.org

# Private Key của ví deploy (KHÔNG được để lộ)
PRIVATE_KEY=

# API Key Etherscan (dùng để verify contract tự động trên Sepolia Etherscan)
ETHERSCAN_API_KEY=
